OPENAI_API_KEY=
HF_TOKEN=
EASYADS_ENV=local

# Database
EASYADS_DB_BACKEND=memory
DATABASE_URL=
# Guest usage
# Enable Supabase Authentication > Anonymous Sign-Ins in the Supabase dashboard.
# Guest users use Supabase anonymous sessions; do not use demo workspace fallback in production.
EASYADS_ALLOW_DEMO_WORKSPACE_FALLBACK=false
EASYADS_DEMO_WORKSPACE_ID=
EASYADS_DEMO_USER_ID=
# Max non-archived chat threads per workspace (default 3). Archiving frees a slot.
EASYADS_MAX_THREADS_PER_WORKSPACE=3

# Asset Storage
EASYADS_ASSET_STORAGE_BACKEND=local_dev
EASYADS_ENABLE_R2_UPLOAD=false
EASYADS_R2_UPLOAD_REQUIRED=false

# Cloudflare R2
EASYADS_R2_BUCKET=
EASYADS_R2_ENDPOINT_URL=
EASYADS_R2_ACCESS_KEY_ID=
EASYADS_R2_SECRET_ACCESS_KEY=
EASYADS_R2_REGION=auto

# URL mode: signed | public
EASYADS_R2_URL_MODE=signed
EASYADS_R2_SIGNED_URL_TTL_SECONDS=3600
EASYADS_R2_PUBLIC_BASE_URL=

# Modal GPU execution
EASYADS_T2I_EXECUTION_BACKEND=local
EASYADS_ENABLE_MODAL_EXECUTION=false
EASYADS_MODAL_SUBMIT_REQUIRED=false
EASYADS_MODAL_POLL_ON_GET=false
EASYADS_MODAL_APP_NAME=easyads-t2i
# Use generate_image for cheap Modal/R2 smoke tests.
# Use generate_flux2_klein_image when testing real FLUX.2 Klein 4B inference.
EASYADS_MODAL_FUNCTION_NAME=generate_image
EASYADS_MODAL_FLUX2_KLEIN_FUNCTION_NAME=generate_flux2_klein_image
# Legacy fallback. generate_flux_schnell_image is kept as an alias that now runs FLUX.2 Klein.
EASYADS_MODAL_FLUX_FUNCTION_NAME=generate_flux2_klein_image
EASYADS_MODAL_SD35_FUNCTION_NAME=generate_sd35_large_image
EASYADS_MODAL_ENVIRONMENT=main
EASYADS_MODAL_DEFAULT_GPU=L40S
EASYADS_MODAL_FLUX_GPU=L40S
EASYADS_MODAL_FLUX_TIMEOUT_SECONDS=900
EASYADS_MODAL_SD35_GPU=L40S
EASYADS_MODAL_SD35_TIMEOUT_SECONDS=1800
EASYADS_MODAL_FLUX_VOLUME_NAME=easyads-hf-cache
EASYADS_MODAL_RESULT_TRANSPORT=inline_base64
EASYADS_MODAL_POLL_TIMEOUT_SECONDS=0
EASYADS_MODAL_POLL_INTERVAL_SECONDS=1
EASYADS_MODAL_MAX_POLL_ATTEMPTS=1
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

T2I_DEFAULT_ENGINE=mock
T2I_OUTPUT_DIR=data/outputs
T2I_ALLOW_API_CALLS=false
T2I_ENABLE_API_COST_GUARD=true
T2I_GPT_IMAGE_MODEL=gpt-image-2
T2I_SD35_MODEL_ID=stabilityai/stable-diffusion-3.5-large
T2I_FLUX_MODEL_ID=black-forest-labs/FLUX.1-schnell
EASYADS_T2I_FLUX2_KLEIN_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
EASYADS_T2I_FLUX2_KLEIN_BACKEND=local_diffusers
EASYADS_T2I_FLUX2_KLEIN_STEPS=4
EASYADS_T2I_FLUX2_KLEIN_GUIDANCE_SCALE=1.0

# T2I actual generation lanes are disabled by default.
EASYADS_ENABLE_EXTERNAL_T2I=false
EASYADS_ENABLE_GPT_IMAGE_2=false
EASYADS_ENABLE_SD35_LOCAL=false
EASYADS_ENABLE_FLUX_LOCAL=false
EASYADS_ENABLE_FLUX2_KLEIN_LOCAL=false

# Do not commit real keys.
HUGGINGFACE_TOKEN=

# LLM runtime
EASYADS_ENABLE_LLM_CALLS=false
EASYADS_LLM_PROVIDER=mock
EASYADS_LLM_MODEL=
EASYADS_LLM_BASE_URL=
EASYADS_LLM_API_STYLE=responses
EASYADS_LLM_TIMEOUT_SECONDS=30
EASYADS_LLM_MAX_RETRIES=0

# Local OpenAI-compatible LLM endpoint (free 플랜 → 로컬 Gemma)
# 기본 OFF: BASE_URL 비움 → free는 결정론 폴백(서빙 안전). eval에서 로컬 Gemma 쓰려면 아래 설정.
# [로컬 Ollama] 호스트에 Ollama 설치 → `ollama pull gemma4:e4b-it-q8_0` →
#   커스텀 GPU 모델: printf 'FROM gemma4:e4b-it-q8_0\nPARAMETER num_gpu 99\n' | ollama create gemma4-e4b-gpu -f -
#   (Ollama systemd override: OLLAMA_HOST=0.0.0.0:11434, OLLAMA_KEEP_ALIVE=60s)
#   EASYADS_LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# [Modal GPU] modal deploy modal_apps/easyads_llm_worker.py → 발급된 URL에 /v1 붙여서 BASE_URL에 설정:
#   EASYADS_LOCAL_LLM_BASE_URL=https://<org>--easyads-llm-gemmaserver-serve.modal.run/v1
#   EASYADS_LOCAL_LLM_MODEL=google/gemma-3-4b-it  (Modal worker의 MODEL_ID와 일치시킬 것)
#   ※ OpenAI 클라이언트는 base_url + "/chat/completions" 를 호출하므로 /v1 접미사 필수
# 컨테이너→호스트: docker-compose orchestrator에 extra_hosts host.docker.internal:host-gateway (설정됨).
# free 게이트: EASYADS_FREE_USE_LOCAL=1 (Makefile이 PLAN=free에서 자동 주입) + LLM_ENABLE_API_CALL=true.
EASYADS_FREE_USE_LOCAL=0
EASYADS_LOCAL_LLM_PROVIDER=local_openai_compat
EASYADS_LOCAL_LLM_BASE_URL=
EASYADS_LOCAL_LLM_API_KEY=local-dev
EASYADS_LOCAL_LLM_MODEL=gemma4-e4b-gpu
EASYADS_LOCAL_LLM_API_STYLE=chat_completions
EASYADS_LOCAL_LLM_TIMEOUT_SECONDS=240
EASYADS_LOCAL_LLM_MAX_RETRIES=1

# Modal LLM worker 빌드 파라미터 (modal deploy 시 로컬 환경에서 읽힘)
# 모델 변경 시 재배포 필요. GPU/타임아웃은 Modal 대시보드에서도 확인 가능.
EASYADS_MODAL_LLM_MODEL_ID=google/gemma-3-4b-it
EASYADS_MODAL_LLM_GPU=L40S
EASYADS_MODAL_LLM_TIMEOUT_SECONDS=600
EASYADS_MODAL_LLM_SCALEDOWN_SECONDS=300
EASYADS_MODAL_LLM_MAX_MODEL_LEN=8192
EASYADS_MODAL_LLM_GPU_MEMORY_UTIL=0.85

# Optional SD3.5 config
EASYADS_SD35_MODEL_ID=stabilityai/stable-diffusion-3.5-large
EASYADS_SD35_LOCAL_PATH=
# 비-distilled SD3.5-Large 샘플링. 기본 28 steps/guidance 4.0. (과거 하드코딩 8 steps → 노이즈 trash, fix.md #23)
# steps는 VRAM 무관(렌더만 느려짐). turbo 체크포인트 쓰면 4 steps/guidance 0.0로 낮춰도 됨.
EASYADS_SD35_STEPS=28
EASYADS_SD35_GUIDANCE_SCALE=4.0
EASYADS_T2I_MAX_IMAGES_PER_JOB=1

# Optional FLUX local config
EASYADS_FLUX_MODEL_ID=black-forest-labs/FLUX.1-schnell
EASYADS_FLUX_LOCAL_PATH=
EASYADS_FLUX_DEVICE=auto
EASYADS_FLUX_NUM_INFERENCE_STEPS=4
EASYADS_FLUX_GUIDANCE_SCALE=0.0
LLM_ENABLE_API_CALL=false
LLM_DEFAULT_PROVIDER=mock
LLM_OPENAI_TEXT_MODEL_NANO=
LLM_OPENAI_TEXT_MODEL_MINI=
LLM_OPENAI_TEXT_MODEL_FULL=
LLM_OPENAI_VISION_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_PROVIDER_STRICT_MODE=true
VISION_UPLOAD_DIR=data/uploads
VISION_PROCESSED_DIR=data/processed
VISION_MAX_FILE_SIZE_MB=20
VISION_MAX_IMAGE_PIXELS=12000000
VISION_DEFAULT_MAX_SIDE=1536
VISION_SAVE_PREVIEW=true
VISION_PREVIEW_MAX_SIDE=512
EASYADS_ENABLE_TEMP_REFERENCES=false
EASYADS_TEMP_REFERENCE_ROOT=data/reference_templates/_temporary_unlicensed

# Shared internal secret between Next proxy / BFF and the orchestrator.
# Unset = no enforcement (local dev). Set the SAME value on all three
# services in production. See docs/auth-boundary.md.
EASYADS_INTERNAL_API_SECRET=
